# ── Wajib ────────────────────────────────────────────────
# Bot token dari Discord Developer Portal → Bot → Reset Token
DISCORD_TOKEN=your_bot_token_here

# Application ID (Developer Portal → General Information → Application ID)
# Sama dengan user ID bot.
BOT_USER_ID=123456789012345678

# ── Lavalink (opsional, default = node publik Serenetia) ──
LAVALINK_HOST=lavalinkv4.serenetia.com:443
LAVALINK_PASSWORD=https://dsc.gg/ajidevserver
LAVALINK_SSL=true

# Level log: trace | debug | info | warn | error
RUST_LOG=info,lavalink_rs=info
